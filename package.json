{
  "name": "lan-voice-server",
  "version": "1.0.0",
  "description": "Self-hosted peer-to-peer voice chat for local networks using WebRTC and Node.js — no internet required",
  "author": "Tom",
  "license": "MIT",
  "keywords": ["voip", "webrtc", "lan", "voice-chat", "self-hosted", "local-network", "websocket"],
  "homepage": "https://github.com/FeiDEV007/LAN-Voice-Server#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/FeiDEV007/LAN-Voice-Server.git"
  },
  "bugs": {
    "url": "https://github.com/FeiDEV007/LAN-Voice-Server/issues"
  },
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "package:exe": "pkg server.js --targets node18-win-x64 --output \"dist/LAN Voice Server.exe\" --compress GZip"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "selfsigned": "^5.5.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  }
}
