{
  "name": "lan-voice-server",
  "version": "1.0.0",
  "description": "Local LAN VoIP application using WebRTC",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg server.js --targets node18-win-x64 --output \"dist/LAN Voice Server.exe\" --compress GZip"
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-forge": "^1.4.0",
    "selfsigned": "^5.5.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  }
}
