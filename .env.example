# Copy this file to .env and adjust values

# Server If AUTH_ENABLED is set to true, authentication is required to access the server.
PORT=3000
AUTH_ENABLED=true
# Set to false when running behind a reverse proxy (e.g. Coolify/nginx) that handles TLS
# Set to true for direct LAN access (generates self-signed cert)
SERVER_TLS_ENABLED=false

# Security
JWT_SECRET=replace-with-a-long-random-secret

# Bootstrap admin (created/promoted on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
